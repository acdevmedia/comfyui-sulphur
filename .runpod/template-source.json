{
  "templateId": "b551wbs9zm",
  "templateName": "Sulfur 2 LTX 2.3 ComfyUI Video One-Click",
  "imageName": "ghcr.io/acdevmedia/sulphur-comyfui:2",
  "containerDiskInGb": 200,
  "volumeMountPath": "/workspace",
  "ports": [
    "8188/http",
    "3923/http"
  ],
  "env": {
    "COMFYUI_ATTENTION": "sage",
    "HF_HOME": "/workspace/.cache/huggingface",
    "HF_TOKEN": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}",
    "SULPHUR_MODEL_VARIANT": "fp8",
    "SULPHUR_VERSION": "2",
    "COPYPARTY_USERNAME": "{{ RUNPOD_SECRET_COPYPARTY_USERNAME }}",
    "COPYPARTY_PASSWORD": "{{ RUNPOD_SECRET_COPYPARTY_SECRET }}"
  },
  "isPublic": true,
  "startJupyter": null,
  "startSsh": null,
  "dockerEntrypoint": null,
  "dockerStartCmd": null,
  "volumeInGb": null
}
