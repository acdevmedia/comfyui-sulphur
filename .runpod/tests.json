{
  "tests": [
    {
      "name": "comfyui_readiness",
      "input": {
        "healthcheck": true
      },
      "timeout": 1800000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA A100 80GB PCIe",
    "gpuCount": 1,
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0"
    ],
    "env": [
      {
        "key": "COMFYUI_ATTENTION",
        "value": "sage"
      },
      {
        "key": "HF_HOME",
        "value": "/workspace/.cache/huggingface"
      },
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "SULPHUR_MODEL_VARIANT",
        "value": "fp8"
      },
      {
        "key": "SULPHUR_VERSION",
        "value": "2"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      }
    ]
  }
}
