{
  "title": "Sulphur 2 ComfyUI",
  "description": "Sulphur 2 ComfyUI: ComfyUI browser workflows for generating video with audio from text, images and soundtracks.",
  "type": "serverless",
  "category": "video",
  "config": {
    "runsOn": "GPU",
    "endpointType": "LB",
    "containerDiskInGb": 200,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80",
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0"
    ],
    "env": [
      {
        "key": "COMFYUI_ATTENTION",
        "input": {
          "name": "Comfyui Attention",
          "type": "string",
          "description": "Attention backend used when the launch settings are first created. Existing user launch settings are preserved.",
          "default": "sage",
          "advanced": true,
          "options": [
            {
              "label": "SageAttention",
              "value": "sage"
            },
            {
              "label": "PyTorch",
              "value": "pytorch"
            }
          ]
        }
      },
      {
        "key": "HF_HOME",
        "input": {
          "name": "Hf Home",
          "type": "string",
          "description": "Hugging Face cache directory on container storage.",
          "default": "/workspace/.cache/huggingface",
          "advanced": true
        }
      },
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "SULPHUR_MODEL_VARIANT",
        "input": {
          "name": "Sulphur Model Variant",
          "type": "string",
          "description": "Checkpoint precision: fp8 (template default) or bf16. Selects model downloads and newly installed workflow checkpoint names.",
          "default": "fp8",
          "advanced": false,
          "options": [
            {
              "label": "BF16",
              "value": "bf16"
            },
            {
              "label": "FP8",
              "value": "fp8"
            }
          ]
        }
      },
      {
        "key": "SULPHUR_VERSION",
        "value": "2"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      }
    ]
  }
}
