# Runtime defaults synchronized from the Runpod account template.
# Secret references are Runpod placeholders, never actual credentials.
COMFYUI_ATTENTION=sage
HF_HOME=/workspace/.cache/huggingface
HF_TOKEN={{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}
SULPHUR_MODEL_VARIANT=fp8
SULPHUR_VERSION=2

# Additional optional image settings, absent from the account template.


# Local deployment tools only. Never pass these to Docker builds or Pods.
RUNPOD_API_KEY=
GITHUB_PACKAGES_PAT=
