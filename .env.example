# Only HF_TOKEN belongs in the pod; use Runpod Secrets for gated downloads.
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
HF_HOME=/workspace/.cache/huggingface
SULPHUR_MODEL_VARIANT=fp8
COMFYUI_ATTENTION=sage
# Local deployment tools only. Never pass these to builds or pods.
RUNPOD_API_KEY=YOUR_RUNPOD_API_KEY
GITHUB_PACKAGES_PAT=YOUR_GITHUB_TOKEN
