{
  "name": "Sulfur 2 LTX 2.3 ComfyUI Video One-Click",
  "imageName": "ghcr.io/acdevmedia/sulphur-comyfui:2",
  "category": "NVIDIA",
  "containerDiskInGb": 200,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "isPublic": true,
  "isServerless": false,
  "ports": [
    "8188/http"
  ],
  "env": {
    "COMFYUI_ATTENTION": "sage",
    "HF_HOME": "/workspace/.cache/huggingface",
    "HF_TOKEN": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}",
    "SULPHUR_MODEL_VARIANT": "fp8",
    "SULPHUR_VERSION": "2"
  }
}
